{
  "name": "yu-code",
  "version": "1.0.16",
  "description": "Yu Code - AI-powered development environment",
  "main": "electron/main.js",
  "scripts": {
    "predev": "node scripts/dev-cleanup.js",
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on file:.dev-port && electron . --dev\"",
    "vendor": "node scripts/vendor-pi.js",
    "build": "node scripts/build.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "agent",
    "desktop",
    "electron"
  ],
